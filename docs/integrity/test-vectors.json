{
  "spec": "arena-integrity/1",
  "description": "Known-answer vectors for docs/INTEGRITY_SPEC.md. Hex is lowercase. Keys here are TEST KEYS ONLY and must never be used for real signatures.",
  "canonicalization": {
    "valid": [
      {
        "name": "object keys are sorted, nested objects too, array order is kept",
        "input_json": "{\"b\":2,\"a\":1,\"c\":{\"z\":1,\"y\":[3,2,1]}}",
        "canonical": "{\"a\":1,\"b\":2,\"c\":{\"y\":[3,2,1],\"z\":1}}"
      },
      {
        "name": "insignificant whitespace is removed and integral floats lose their fraction",
        "input_json": "{ \"n\": 1.0, \"m\": 1e2, \"s\": \"x\" }",
        "canonical": "{\"m\":100,\"n\":1,\"s\":\"x\"}"
      },
      {
        "name": "number forms follow ECMAScript Number-to-String (negative zero becomes 0)",
        "input_json": "[0.000001, 1e-7, 9007199254740991, -0, 0.1, 100, 1.5, -1e-9]",
        "canonical": "[0.000001,1e-7,9007199254740991,0,0.1,100,1.5,-1e-9]"
      },
      {
        "name": "string escapes: short forms, lowercase \\u for other control characters, everything else literal",
        "input_json": "\"line\\nbreak \\\"quote\\\" \\\\ tab\\t bell\\u0007 del\\u007f \\u00e9 \\ud83d\\ude00\"",
        "canonical": "\"line\\nbreak \\\"quote\\\" \\\\ tab\\t bell\\u0007 del é 😀\""
      },
      {
        "name": "keys sort by UTF-16 code unit, not by code point",
        "input_json": "{\"\\ud83d\\ude00\":1,\"\\uffff\":2,\"a\":3}",
        "canonical": "{\"a\":3,\"😀\":1,\"￿\":2}"
      },
      {
        "name": "null, booleans, empty containers",
        "input_json": "{\"d\":{},\"c\":[],\"b\":true,\"a\":null}",
        "canonical": "{\"a\":null,\"b\":true,\"c\":[],\"d\":{}}"
      }
    ],
    "invalid": [
      {
        "name": "lone surrogate in a string",
        "input_json": "\"\\ud800\"",
        "rejected": true
      },
      {
        "name": "integer outside the safe range (2^53 + 1 parses to 2^53)",
        "input_json": "9007199254740993",
        "rejected": true
      },
      {
        "name": "number that overflows to infinity",
        "input_json": "1e400",
        "rejected": true
      },
      {
        "name": "large integral number (1e21)",
        "input_json": "1e21",
        "rejected": true
      }
    ]
  },
