<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Investor Relations' %> | LLM Arena IR</title>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <!-- Fonts: Playfair Display for Serifs (Premium) + Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>[x-cloak]{display:none !important;}</style>
    <style>
        /* Investor Theme Overrides */
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', serif; }
        .nav-link { color: #475569; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.75rem; line-height: 1rem; font-weight: 600; padding-bottom: 0.25rem; border-bottom: 2px solid transparent; transition: color .15s ease, border-color .15s ease; }
        .nav-link:hover { color: #0f172a; }
        .nav-link-active { color: #0f172a; border-bottom-color: #0f172a; }
        .btn-ir { padding: 0.75rem 1.5rem; background: #0f172a; color: #fff; font-family: 'Playfair Display', serif; font-style: italic; transition: background-color .15s ease; }
        .btn-ir:hover { background: #334155; }
        /* Footer links: comfortable to tap on phones, compact from md up */
        .ir-footer-link { display: inline-flex; align-items: center; min-height: 44px; }
        @media (min-width: 768px) { .ir-footer-link { min-height: 0; } }
    </style>
</head>
<body class="flex flex-col min-h-screen">
    
    <!-- Investor Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50" x-data="{ open: false }">
        <div class="container mx-auto px-4 sm:px-6 py-4 sm:py-6 flex justify-between items-center gap-3">
            <a href="/investors" class="text-xl sm:text-2xl font-serif font-bold tracking-tight flex items-center gap-3 whitespace-nowrap">
                <div class="w-8 h-8 bg-slate-900 text-white flex items-center justify-center font-sans font-bold text-xs rounded-full">IR</div>
                LLM Arena <span class="hidden sm:inline text-slate-400 font-sans text-xs uppercase tracking-widest mt-1 ml-1">Investors</span>
            </a>
            
            <nav class="hidden md:flex space-x-8">
                <a href="/investors" class="<%= path === '/investors' ? 'nav-link-active' : '' %> nav-link">Overview</a>
                <a href="/investors/financials" class="<%= path === '/investors/financials' ? 'nav-link-active' : '' %> nav-link">Financials</a>
                <a href="/investors/press" class="<%= path === '/investors/press' ? 'nav-link-active' : '' %> nav-link">Press</a>
                <a href="/investors/filings" class="<%= path === '/investors/filings' ? 'nav-link-active' : '' %> nav-link">SEC Filings</a>
                <a href="/investors/contact" class="<%= path === '/investors/contact' ? 'nav-link-active' : '' %> nav-link">Contact</a>
            </nav>

            <div class="hidden md:flex">
                <a href="/" class="text-xs font-bold text-slate-400 hover:text-slate-900 uppercase tracking-widest">
                Return to Product &rarr;
                </a>
            </div>
            <button type="button" class="md:hidden min-h-[2.75rem] text-xs font-bold uppercase tracking-widest text-slate-500 border border-slate-200 px-4 py-2" @click="open = !open" :aria-expanded="open.toString()">
                <span x-text="open ? 'Close' : 'Menu'"></span>
            </button>
        </div>
        <div x-show="open" x-cloak x-transition class="md:hidden border-t border-slate-200 bg-slate-900 text-white">
            <div class="container mx-auto px-6 py-6 space-y-4">
                <div class="grid gap-3 text-xs uppercase tracking-widest">
                    <a href="/investors" class="hover:text-slate-200">Overview</a>
                    <a href="/investors/financials" class="hover:text-slate-200">Financials</a>
                    <a href="/investors/press" class="hover:text-slate-200">Press</a>
                    <a href="/investors/filings" class="hover:text-slate-200">SEC Filings</a>
                    <a href="/investors/contact" class="hover:text-slate-200">Contact</a>
                </div>
                <a href="/" class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-slate-300 hover:text-white">
                    Return to Product <span aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </div>
    </header>

    <main class="flex-grow">
        <%- body %>
    </main>

    <!-- Investor Footer -->
    <footer class="bg-slate-900 text-slate-400 border-t-4 border-slate-800 pt-10 md:pt-12" style="padding-bottom: max(2rem, env(safe-area-inset-bottom));">
        <div class="container mx-auto px-5 sm:px-6 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 md:gap-8">
            <div class="col-span-2">
                <h4 class="text-white font-serif text-xl mb-3 md:mb-4">LLM Arena Inc.</h4>
                <p class="text-sm leading-relaxed max-w-sm">
                    Defining the standard for artificial intelligence evaluation.
                    Traded on NYSE as <strong>ARENA</strong>.
                </p>
            </div>
            <nav aria-label="Governance" class="min-w-0">
                <h5 class="text-white text-xs font-bold uppercase tracking-[0.14em] mb-2 min-h-8 md:min-h-0 md:mb-4">Governance</h5>
                <ul class="text-sm md:space-y-2">
                    <li><a href="/investors/governance/board" class="ir-footer-link hover:text-white">Board of Directors</a></li>
                    <li><a href="/investors/governance/executives" class="ir-footer-link hover:text-white">Executive Team</a></li>
                    <li><a href="/investors/governance/committees" class="ir-footer-link hover:text-white">Committee Composition</a></li>
                    <li><a href="/investors/governance/documents" class="ir-footer-link hover:text-white">Governance Documents</a></li>
                </ul>
            </nav>
            <nav aria-label="Shareholder services" class="min-w-0">
                <h5 class="text-white text-xs font-bold uppercase tracking-[0.14em] mb-2 min-h-8 md:min-h-0 md:mb-4">Shareholder Services</h5>
                <ul class="text-sm md:space-y-2">
                    <li><a href="/investors/contact" class="ir-footer-link hover:text-white">Transfer Agent</a></li>
                    <li><a href="/investors/financials" class="ir-footer-link hover:text-white">Dividend History</a></li>
                    <li><a href="/investors/faq" class="ir-footer-link hover:text-white">Investor FAQs</a></li>
                </ul>
            </nav>
        </div>
        <div class="container mx-auto px-5 sm:px-6 mt-10 md:mt-12 pt-6 md:pt-8 border-t border-slate-800 text-xs flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
            <span class="leading-relaxed">&copy; 2026 LLM Arena Inc. All rights reserved.</span>
            <nav aria-label="Legal" class="flex flex-wrap gap-x-6">
                <a href="/careers" class="ir-footer-link hover:text-white">Careers</a>
                <a href="/terms" class="ir-footer-link hover:text-white">Terms</a>
                <a href="/privacy" class="ir-footer-link hover:text-white">Privacy</a>
            </nav>
        </div>
    </footer>

</body>
</html>
